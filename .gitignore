*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/

# Virtual environments
.venv/
venv/
env/
ENV/
.venv312/
venv312/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Coverage reports
.coverage
.coverage.*
coverage/
htmlcov/

