.idea/
*.swp
*.swo

# UV lock and cache
.uv/


# Local databases and SQLite runtime sidecars
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Data files (CSVs, JSONs, model weights — too large / PII-sensitive for git)
data/raw/**/*.csv
data/raw/**/*.json
data/raw/**/*.pdf
# Cron run snapshots (local backend) — separate from immutable raw seed data
data/cron/**/*.csv
data/cron/**/*.json
data/cron/**/*.pdf
data/cron/**/*.txt
data/processed/**/*.csv
data/processed/**/*.json
data/final/**/*.csv
data/final/**/*.json
data/models/**/*.onnx
data/models/**/*.bin
data/models/**/*.pt
data/models/**/*.safetensors
# Keep folder structure and READMEs
!data/README.md
!data/**/.gitkeep
data/raw/
data/cron/
data/local/
data/exports/
data/final/
data/processed/
data/models/

