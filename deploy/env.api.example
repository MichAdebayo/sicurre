# Copy to deploy/env.api on the server.
# Loaded only by the FastAPI/data-platform container.

# Core runtime
SICURRE_ENVIRONMENT=production
SICURRE_TELEMETRY_TRACES_ENABLED=true
SICURRE_TELEMETRY_OTLP_ENDPOINT=http://alloy:4318/v1/traces
SICURRE_TELEMETRY_TRACE_SAMPLE_RATIO=1.0
SICURRE_OPERATIONAL_TESTS_ENABLED=false
SICURRE_OPERATIONAL_TEST_MAX_DURATION_SECONDS=600
SICURRE_AUTH_ENABLED=true
# Generate once with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
SICURRE_SECRET_ENCRYPTION_KEY=replace-with-url-safe-base64-32-byte-key
# Keep disabled in production: source-specific Hetzner cron invokes each job.
SICURRE_SCHEDULER_ENABLED=false
# Legacy local/dev fallback only. 604800 seconds is seven days.
SICURRE_SCHEDULER_INTERVAL_SECONDS=604800
SICURRE_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DB?ssl=require
SICURRE_DATA_PLATFORM_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DB?ssl=require

# Public/internal API routing
SICURRE_PUBLIC_API_URL=https://sicurre.com
SICURRE_INFERENCE_API_URL=https://api.sicurre.com/v1/classify
# Production Compose overrides inference with the private service-mesh address
# and uses this internal gateway only for admin health probes.
SICURRE_INTERNAL_APP_PROBE_URL=http://sicurre-app:5173
# Shared only with trusted service-to-service callback callers such as Sicurre-ML.
# Generate independently from the inference key: openssl rand -hex 32
SICURRE_INTERNAL_API_KEY=replace-with-internal-callback-token
SICURRE_INFERENCE_API_KEY=replace-with-internal-shared-token
SICURRE_SLA_LATENCY_MS=2000

# Cloudflare Tooling
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-token
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account

# Dataset publishing and ML retraining dispatch
KAGGLE_USERNAME=replace-with-kaggle-username
KAGGLE_API_TOKEN=replace-with-kaggle-token
KAGGLE_DATASET_SLUG=replace-with-kaggle-dataset-slug
SICURRE_GITHUB_ML_REPO_OWNER=michaeladebayo99
SICURRE_GITHUB_ML_DISPATCH_TOKEN=replace-with-github-actions-token

# R2 raw snapshot storage
SICURRE_RAW_SNAPSHOT_STORAGE_BACKEND=prod
SICURRE_RAW_SNAPSHOT_R2_BUCKET_NAME=sicurre-raw
SICURRE_RAW_SNAPSHOT_R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
SICURRE_RAW_SNAPSHOT_R2_ACCESS_KEY_ID=replace-with-r2-access-key
SICURRE_RAW_SNAPSHOT_R2_SECRET_ACCESS_KEY=replace-with-r2-secret-key
SICURRE_RAW_SNAPSHOT_R2_REGION=auto

# Private, TTL-managed raw MIME custody for false-positive release.
SICURRE_QUARANTINE_STORAGE_BACKEND=r2
SICURRE_QUARANTINE_R2_BUCKET_NAME=sicurre-quarantine
SICURRE_QUARANTINE_R2_PREFIX=quarantine
SICURRE_QUARANTINE_RETENTION_DAYS=14
SICURRE_QUARANTINE_MAX_MESSAGE_BYTES=5242880
SICURRE_RAW_SNAPSHOT_PREFIX=raw-snapshots

# Workspace-scoped false-negative forwarding and sanitized R2 evidence.
SICURRE_REPORTED_EMAIL_ADDRESS=report@sicurre.com
SICURRE_REPORTED_EMAIL_ALIAS_SECRET=replace-with-at-least-32-random-bytes
SICURRE_REPORTED_EMAIL_INGEST_KEY=replace-with-worker-to-api-secret
SICURRE_REPORTED_EMAIL_STORAGE_BACKEND=r2
SICURRE_REPORTED_EMAIL_R2_BUCKET_NAME=replace-with-reported-email-bucket
SICURRE_REPORTED_EMAIL_R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
SICURRE_REPORTED_EMAIL_R2_ACCESS_KEY_ID=replace-with-bucket-scoped-access-key
SICURRE_REPORTED_EMAIL_R2_SECRET_ACCESS_KEY=replace-with-bucket-scoped-secret-key
SICURRE_REPORTED_EMAIL_R2_REGION=auto
SICURRE_REPORTED_EMAIL_R2_PREFIX=reported-email
SICURRE_REPORTED_EMAIL_MAX_MESSAGE_BYTES=5242880

# Source-specific storage backends
SICURRE_PHISHTANK_SNAPSHOT_STORAGE_BACKEND=prod
SICURRE_CERTFR_SNAPSHOT_STORAGE_BACKEND=prod
SICURRE_SAP_LABS_SNAPSHOT_STORAGE_BACKEND=prod
SICURRE_COMMON_CRAWL_SNAPSHOT_STORAGE_BACKEND=prod
SICURRE_DATABASE_HISTORICAL_SNAPSHOT_STORAGE_BACKEND=prod

# Source-specific configs
SICURRE_PHISHTANK_SNAPSHOT_PREFIX=replace-with-preferred-prefix
SICURRE_PHISHTANK_USER_AGENT=replace-with-user-agent

# Common Crawl cadence/runtime bounds
CC_INPUT_BACKEND=prod
CC_TARGET_RECORDS=1500
CC_MAX_WARC_DOWNLOADS=12
CC_MAX_RESULTS_PER_QUERY=250
CC_ASYNC_CONCURRENCY=6
CC_MIN_TEXT_LENGTH=200
CC_MAX_TEXT_LENGTH=6000
CC_REQUEST_TIMEOUT=30
CC_WARC_RETRY_DELAY_SECONDS=1.5
CC_WARC_MAX_RETRIES=3
SICURRE_CC_CRON_DURATION_MODE=standard
SICURRE_CC_CRON_LOOKBACK_INDICES=18
SICURRE_CC_CRON_INDEX_MAX_ATTEMPTS=3
SICURRE_CC_CRON_INDEX_RETRY_BACKOFF_SECONDS=60

# Database historical source
SICURRE_DATABASE_HISTORICAL_CRON_TOTAL_COUNT=500
SICURRE_DATABASE_HISTORICAL_CRON_MAX_TOTAL_COUNT=2000
SICURRE_DB_INGEST_FORCE_RESEED=false

# Optional LLM/data enrichment providers
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
CEREBRAS_MODEL_TEMPERATURE=0.2
GROQ_API_KEY=
GROQ_MODEL=
GROQ_MODEL_TEMPERATURE=0.2
GEMINI_API_KEY=
GEMINI_MODEL=

# Mailer events emitted by API routes
LOOPS_API_KEY=
LOOPS_THREAT_QUARANTINED_TRANSACTION_ID=
LOOPS_DNS_SHIELD_ALERT_TRANSACTION_ID=
LOOPS_EMERGECNY_LOCKDOWN_TRANSACTION_ID=
LOOPS_QUOTA_WARNING_TRANSACTION_ID=

# Spamhaus DQS — free community key for domain reputation checks.
# Sign up at https://www.spamhaus.org/free-trial/sign-up-free-community-account/
SPAMHAUSE_DQS_API_KEY=

# GCP
SICURRE_GCP_PROJECT=replace-with-project-name
SICURRE_GCP_REGION=replace-with-region
DATASET_ID=replace-with-dataset-id
TABLE_ID=replace-with-table-id
