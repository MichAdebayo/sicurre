      "id": 2,
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sicurre_app_gateway_uptime_seconds",
          "legendFormat": "uptime",
          "refId": "A"
