{
  "uid": "sicurre-controlled-exercise",
  "title": "Sicurre / Alert-chain evidence",
  "description": "Synthetic monitoring exercise, independent of customer traffic. Signal activation is not an API outage. Grafana alert state and email receipt are separate observations.",
  "schemaVersion": 40,
  "version": 1,
  "editable": true,
  "tags": [
    "sicurre",
    "monitoring",
    "exercise"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Alert state and history",
      "type": "link",
      "url": "/alerting/grafana/sicurre-controlled-exercise/view",
      "targetBlank": false
    },
    {
      "title": "Application health",
      "type": "link",
      "url": "/d/sicurre-app-runtime",
      "targetBlank": false
    },
    {
      "title": "ML runtime",
      "type": "link",
      "url": "/d/sicurre-ml-runtime",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "type": "datasource",
        "query": "prometheus",
        "hide": 2
      },
      {
        "name": "loki",
        "type": "datasource",
        "query": "loki",
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Synthetic signal",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(max(sicurre_operational_exercise_active{stack=\"sicurre\"}) or (0 * min(up{stack=\"sicurre\",service_name=\"sicurre-api\"}))) and on() (min(up{stack=\"sicurre\",service_name=\"sicurre-api\"}) == 1)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "left",
        "text": {
          "valueSize": 26
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "No telemetry",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Inactive",
                  "color": "green"
                },
                "1": {
                  "text": "Active",
                  "color": "orange"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "API scrape",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(up{stack=\"sicurre\",service_name=\"sicurre-api\"})",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "left",
        "text": {
          "valueSize": 26
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "No telemetry",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unavailable",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "ML scrape",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(up{stack=\"sicurre-ml\",service_name=\"sicurre-ml-inference\"})",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "left",
        "text": {
          "valueSize": 26
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "No telemetry",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unavailable",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Inference service scrape availability during the synthetic test."
    },
    {
      "id": 4,
      "title": "Synthetic signal history",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(max(sicurre_operational_exercise_active{stack=\"sicurre\"}) or (0 * min(up{stack=\"sicurre\",service_name=\"sicurre-api\"}))) and on() (min(up{stack=\"sicurre\",service_name=\"sicurre-api\"}) == 1)",
          "legendFormat": "Alert-chain test",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#5794F2"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false,
            "showPoints": "never",
            "axisLabel": "0 inactive / 1 active",
            "axisBorderShow": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Customer API server errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(sicurre_app_gateway_responses_total{stack=\"sicurre\",route=~\"app|api|auth\",status=~\"5..\"}[$__rate_interval])) or (0 * sum(increase(sicurre_app_gateway_responses_total{stack=\"sicurre\",route=~\"app|api|auth\"}[$__rate_interval])))",
          "legendFormat": "5xx",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#5794F2"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false,
            "showPoints": "never",
            "axisLabel": "Requests",
            "axisBorderShow": false,
            "axisSoftMax": 1
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Real request failures, not the synthetic exercise metric. No series is shown when this counter is unavailable."
    },
    {
      "id": 6,
      "title": "Exercise log",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{stack=\"sicurre\",service_name=\"sicurre-api\"} |~ \"(?i)operational exercise\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Ascending"
      }
    }
  ]
}
