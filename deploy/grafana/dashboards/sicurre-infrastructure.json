    {"id": 4, "type": "stat", "title": "Host Metrics Collector", "description": "Reachability of the node-exporter process that supplies this dashboard.", "datasource": {"type": "prometheus", "uid": "${prometheus}"}, "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0}, "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"color": "red", "text": "Down"}, "1": {"color": "green", "text": "Operational"}}, "type": "value"}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}, "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}, "targets": [{"expr": "up{job=\"prometheus.scrape.host\"}", "refId": "A"}]},
