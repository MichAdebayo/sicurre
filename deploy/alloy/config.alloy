discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "sicurre" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		regex         = "sicurre-prod"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}

	// cAdvisor is observed through Prometheus. Its repetitive runtime warnings
	// remain in Docker's rotated local logs for SSH diagnosis, not in Loki.
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "cadvisor"
		action        = "drop"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service_name"
	}

	rule {
		target_label = "job"
		replacement  = "sicurre"
	}
}

prometheus.scrape "app_gateway" {
	targets = [{
		"__address__"  = "sicurre-app:5173",
		"service_name" = "sicurre-app",
	}]
	metrics_path    = "/metrics"
	scrape_interval = "60s"
	forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.scrape "api" {
	targets = [{
		"__address__"  = "sicurre-api:8001",
		"service_name" = "sicurre-api",
	}]
	metrics_path    = "/metrics"
	scrape_interval = "60s"
	forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.scrape "host" {
	targets = [{
		"__address__"  = "node-exporter:9100",
		"service_name" = "sicurre-host",
	}]
	scrape_interval = "60s"
	forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.scrape "containers" {
	targets = [{
		"__address__"  = "cadvisor:8080",
		"service_name" = "sicurre-containers",
	}]
	scrape_interval = "60s"
	forward_to      = [prometheus.relabel.sicurre_containers.receiver]
}

// cAdvisor exposes thousands of kernel, TCP, and container-label series for
// every workload on the shared host. Retain only bounded operational signals
// for containers owned by this Compose project plus scrape health metadata.
prometheus.relabel "sicurre_containers" {
	forward_to = [prometheus.remote_write.grafana_cloud.receiver]

	rule {
		source_labels = ["__name__", "container_label_com_docker_compose_project"]
		regex         = "(up|scrape_.*);.*|(container_cpu_usage_seconds_total|container_memory_working_set_bytes|container_network_receive_bytes_total|container_network_transmit_bytes_total|container_oom_events_total|container_last_seen);sicurre-prod"
		action        = "keep"
	}

	rule {
		source_labels = ["container_label_com_docker_compose_service"]
		target_label  = "container_service"
	}

	rule {
		regex  = "container_label_.*|id|image"
		action = "labeldrop"
	}
}

prometheus.scrape "alloy" {
	targets = [{
		"__address__"  = "127.0.0.1:12345",
		"service_name" = "sicurre-alloy",
	}]
	scrape_interval = "60s"
	forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
	endpoint {
		url = sys.env("GRAFANA_PROMETHEUS_REMOTE_WRITE_URL")

		basic_auth {
			username = sys.env("GRAFANA_PROMETHEUS_METRICS_USERNAME")
			password = sys.env("GRAFANA_PROMETHEUS_METRICS_API_TOKEN")
		}
	}

	external_labels = {
		env    = "production",
		stack  = "sicurre",
		server = "hetzner-cx33",
	}
}

loki.source.docker "sicurre" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.sicurre.output
	forward_to = [loki.process.sicurre.receiver]
}

loki.process "sicurre" {
	forward_to = [loki.write.grafana_cloud.receiver]

	stage.json {
		expressions = {
			level   = "level",
			service = "service",
		}
	}

	stage.labels {
		values = {
			level   = "",
			service = "",
		}
	}

	stage.drop {
		expression = "GET /__app/health"
	}

	stage.drop {
		expression = "GET /health"
	}

	stage.drop {
		expression = "GET /metrics"
	}
}

loki.write "grafana_cloud" {
	endpoint {
		url = sys.env("GRAFANA_LOKI_URL")

		basic_auth {
			username = sys.env("GRAFANA_LOKI_USER")
			password = sys.env("GRAFANA_LOKI_WRITE_API_TOKEN")
		}
	}

	external_labels = {
		env    = "production",
		stack  = "sicurre",
		server = "hetzner-cx33",
	}
}

// The receiver is ready for application traces once the API/auth services are
// instrumented. Prometheus and Docker/Loki continue to cover host operations.
otelcol.auth.basic "grafana_cloud" {
	username = sys.env("GRAFANA_OPEN_TELEMETRY_INSTANCE_ID")
	password = sys.env("GRAFANA_OPEN_TELEMETRY_API_TOKEN")
}

otelcol.exporter.otlphttp "grafana_cloud" {
	client {
		endpoint = sys.env("GRAFANA_OPEN_TELEMETRY_OTLP_ENDPOINT")
		auth     = otelcol.auth.basic.grafana_cloud.handler
	}
}

otelcol.receiver.otlp "sicurre" {
	grpc {
		endpoint = "0.0.0.0:4317"
	}

	http {
		endpoint = "0.0.0.0:4318"
	}

	output {
		traces = [otelcol.exporter.otlphttp.grafana_cloud.input]
	}
}
