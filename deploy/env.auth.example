# Copy to deploy/env.auth on the server.
# Loaded only by the Better Auth sidecar.

SICURRE_BETTER_AUTH_SECRET=replace-with-strong-random-secret
SICURRE_BETTER_AUTH_URL=https://sicurre.com
BETTER_AUTH_URL=https://sicurre.com
SICURRE_FRONTEND_ORIGIN=https://sicurre.com
SICURRE_BETTER_AUTH_PORT=3005
SICURRE_BETTER_AUTH_DB_PATH=/app/data/local/better-auth.db

# Password/email verification transactional mail
LOOPS_API_KEY=replace-with-loops-key
LOOPS_SIGN_UP_TRANSACTION_ID=replace-with-loops-template
LOOPS_RESET_PASSWORD_TRANSACTION_ID=replace-with-loops-template

# Cloudflare Turnstile. The secret is server-only; the site key is public but
# stays with the auth configuration until the client widget is enabled.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Optional local admin bootstrap script values; not required by the sidecar at runtime.
SICURRE_ADMIN_EMAIL=
SICURRE_ADMIN_PASSWORD=
SICURRE_ADMIN_NAME=
SICURRE_PLATFORM_ADMIN_EMAILS=
