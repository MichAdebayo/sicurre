# Copy to deploy/env.alloy on the server only when enabling the observability
# profile. Loaded only by Grafana Alloy.

# Prometheus remote write
GRAFANA_PROMETHEUS_REMOTE_WRITE_URL=https://prometheus-prod.example.grafana.net/api/prom/push
GRAFANA_PROMETHEUS_METRICS_USERNAME=replace-with-prometheus-instance-id
GRAFANA_PROMETHEUS_METRICS_API_TOKEN=replace-with-prometheus-write-token

# Loki Docker logs
GRAFANA_LOKI_URL=https://logs-prod.example.grafana.net/loki/api/v1/push
GRAFANA_LOKI_USER=replace-with-loki-instance-id
GRAFANA_LOKI_API_TOKEN=replace-with-loki-write-token

# OTLP gateway for future API/Auth tracing and application logs.
GRAFANA_OPEN_TELEMETRY_OTLP_ENDPOINT=https://otlp.example.grafana.net/otlp
GRAFANA_OPEN_TELEMETRY_INSTANCE_ID=replace-with-otlp-instance-id
GRAFANA_OPEN_TELEMETRY_API_TOKEN=replace-with-otlp-write-token

# Operator-only credentials. Do not inject these into the Alloy container.
# GRAFANA_URL=https://your-stack.grafana.net
# GRAFANA_SERVICE_ACCOUNT_TOKEN=dashboard-read-write-token
# GRAFANA_GCX_TOKEN=local-gcx-cli-token
# GRAFANA_GITHUB_PAT=optional-grafana-github-integration-token
