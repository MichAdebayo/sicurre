# Copy to deploy/env.alloy on the server only when enabling the observability profile.
# Loaded only by the Grafana Alloy container.

GRAFANA_REMOTE_WRITE_URL=https://prometheus-prod.example.grafana.net/api/prom/push
GRAFANA_METRICS_USERNAME=replace-with-prometheus-user
GRAFANA_LOKI_URL=https://logs-prod.example.grafana.net/loki/api/v1/push
GRAFANA_LOKI_USERNAME=replace-with-loki-user
GRAFANA_API_TOKEN=replace-with-grafana-cloud-token
