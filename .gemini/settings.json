{
  "hooksConfig": {
    "enabled": true
  },
  "hooks": {
    "BeforeAgent": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "name": "verify-env",
            "type": "command",
            "command": "bash .gemini/hooks/verify-env.sh",
            "description": "Verifies that local environment secrets are not exposed or committed."
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "name": "block-destructive-commands",
            "type": "command",
            "command": "bash .gemini/hooks/block-destructive-commands.sh",
            "description": "Prevents execution of dangerous or destructive command lines."
          }
        ]
      }
    ]
  }
}
