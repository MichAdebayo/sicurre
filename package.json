{
  "name": "sicurre",
  "version": "1.0.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "description": "Real-time phishing detection and inbox remediation for French auto-entrepreneurs and TPEs.",
  "scripts": {
    "auth:dev": "tsx auth-service/main.ts",
    "auth:migrate": "tsx scripts/app/migrate-better-auth.ts",
    "auth:typecheck": "tsc -p auth-service/tsconfig.json --noEmit",
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "grafana:provision": "node scripts/deploy/provision_grafana_dashboard.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichAdebayo/sicurre.git"
  },
  "license": "MIT",
  "dependencies": {
    "@hookform/resolvers": "3.10.0",
    "@tanstack/react-query": "5.80.7",
    "better-auth": "^1.6.23",
    "better-sqlite3": "^12.11.1",
    "clsx": "2.1.1",
    "cors": "2.8.5",
    "dotenv": "17.2.1",
    "express": "^4.22.2",
    "framer-motion": "11.18.2",
    "i18next": "23.16.5",
    "kysely": "^0.28.17",
    "lucide-react": "0.511.0",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "7.56.4",
    "react-i18next": "14.1.3",
    "react-router": "^8.3.0",
    "tailwind-merge": "2.5.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/cors": "2.8.18",
    "@types/express": "5.0.3",
    "@types/node": "20.19.1",
    "@types/pg": "^8.20.0",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "supertest": "^7.2.2",
    "tailwindcss": "4.3.1",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vite": "8.0.16",
    "vitest": "^4.1.10"
  }
